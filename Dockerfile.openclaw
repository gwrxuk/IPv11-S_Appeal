FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-openclaw.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY openclaw_demo.py /app/openclaw_demo.py

EXPOSE 8011

CMD ["uvicorn", "openclaw_demo:app", "--host", "0.0.0.0", "--port", "8011"]
